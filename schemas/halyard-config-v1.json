{
  "$comment": "Generated by `cargo run -p xtask -- schema-check --write` from the halyard-config types. Do not edit by hand; an ADR is required for format changes.",
  "$defs": {
    "BumpLevel": {
      "description": "Bump magnitude accepted by configuration (subset of `Bump`; `none`\ndisables a mapping).",
      "oneOf": [
        {
          "const": "none",
          "description": "No bump.",
          "type": "string"
        },
        {
          "const": "patch",
          "description": "Patch bump.",
          "type": "string"
        },
        {
          "const": "minor",
          "description": "Minor bump.",
          "type": "string"
        },
        {
          "const": "major",
          "description": "Major bump.",
          "type": "string"
        }
      ]
    },
    "CargoPublishCfg": {
      "description": "`publish.cargo` options.",
      "properties": {
        "registry": {
          "description": "Registry name; default `crates.io`.",
          "type": [
            "string",
            "null"
          ]
        },
        "wait_for_index": {
          "description": "How long to wait for the index to reflect a publish before releasing\ndependents, e.g. `\"90s\"` (§13 visibility wait).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CascadePolicy": {
      "description": "Cascade policy (§10.4).",
      "oneOf": [
        {
          "const": "always",
          "description": "Cascade to normal deps of publishable crates whenever anything\nupstream bumps.",
          "type": "string"
        },
        {
          "const": "when-unsatisfied",
          "description": "Cascade only when the dependent's requirement no longer admits the\nnew version (default for libraries).",
          "type": "string"
        },
        {
          "const": "never",
          "description": "Never cascade automatically.",
          "type": "string"
        }
      ]
    },
    "ChangelogCfg": {
      "description": "`[changelog]` section.",
      "properties": {
        "hidden_types": {
          "description": "Commit types hidden from notes (default: `chore`, `docs`, `ci`,\n`test`, `style`).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "style": {
          "description": "Built-in style name (`keep-a-changelog`, `conventional`, `compact`,\n`github-release-notes`) or a path to a minijinja template (§9.4).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CommitMode": {
      "description": "Release-branch commit mode (§11.5).",
      "oneOf": [
        {
          "const": "git",
          "description": "Push commits with git (`--force-with-lease` CAS).",
          "type": "string"
        },
        {
          "const": "api",
          "description": "Create commits through the forge API (signed/verified commits).",
          "type": "string"
        },
        {
          "const": "auto",
          "description": "`api` when an App token is present, `git` otherwise (default).",
          "type": "string"
        }
      ]
    },
    "CommitsCfg": {
      "description": "`[commits]` section.",
      "properties": {
        "initial_release": {
          "anyOf": [
            {
              "$ref": "#/$defs/InitialReleaseCfg"
            },
            {
              "type": "null"
            }
          ],
          "description": "Options for packages with no release base yet (§8.3)."
        },
        "merge_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/MergePolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "How merge commits are diffed (§8.5). Currently only\n`first-parent` (the default) is defined."
        },
        "types": {
          "additionalProperties": {
            "$ref": "#/$defs/BumpLevel"
          },
          "description": "Commit type → bump mapping (`feat` → `minor`, …); unmapped types\nfollow `bump_unknown` semantics (§10.1).",
          "type": [
            "object",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ForgeCfg": {
      "description": "`[forge]` section.",
      "properties": {
        "commit_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "How release-branch commits are made (§11.5)."
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForgeKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Forge adapter (invariant I9: an adapter, not an assumption)."
        }
      },
      "type": "object"
    },
    "ForgeKind": {
      "description": "Supported forge adapters in the v1 line.",
      "oneOf": [
        {
          "const": "github",
          "description": "GitHub REST adapter (`M4.1`).",
          "type": "string"
        },
        {
          "const": "gitlab",
          "description": "GitLab adapter (Year 2, `M7`).",
          "type": "string"
        },
        {
          "const": "gitea",
          "description": "Gitea/Forgejo adapter (Year 2, `M7`).",
          "type": "string"
        }
      ]
    },
    "InitialReleaseCfg": {
      "description": "`initial_release` options (§8.3 complexity bound).",
      "properties": {
        "max_commits": {
          "description": "Maximum history to walk for a package with no tag (default 10 000).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "LinkCfg": {
      "description": "`[[link]]` explicit polyglot link (§6.5).",
      "properties": {
        "from": {
          "description": "Source package name (e.g. a Rust crate).",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Link semantics: `cascade` (default) or `lockstep`."
        },
        "to": {
          "description": "Target package name (e.g. an npm package).",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "LinkMode": {
      "description": "Polyglot link semantics (§6.5).",
      "oneOf": [
        {
          "const": "cascade",
          "description": "Bump the dependent by at least `patch` when the source bumps.",
          "type": "string"
        },
        {
          "const": "lockstep",
          "description": "Source and target always carry the same version.",
          "type": "string"
        }
      ]
    },
    "MergePolicy": {
      "description": "Merge-commit diffing policy (§8.5). Only the documented default exists in\nv1; further values require an ADR.",
      "oneOf": [
        {
          "const": "first-parent",
          "description": "Diff each commit against its first parent only; merge commits are\nnever counted as changes themselves.",
          "type": "string"
        }
      ]
    },
    "NpmAccess": {
      "description": "npm package access level.",
      "oneOf": [
        {
          "const": "public",
          "description": "Public package.",
          "type": "string"
        },
        {
          "const": "restricted",
          "description": "Restricted package.",
          "type": "string"
        }
      ]
    },
    "NpmPublishCfg": {
      "description": "`publish.npm` options.",
      "properties": {
        "access": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpmAccess"
            },
            {
              "type": "null"
            }
          ],
          "description": "npm access level (`public` | `restricted`)."
        },
        "provenance": {
          "description": "Emit npm provenance attestations (§13.6).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PackageOverride": {
      "description": "`[[package]]` per-package override (§16.4).",
      "properties": {
        "exclude": {
          "description": "Changed paths excluded from package attribution (§8.4).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "description": "Files that count as \"changes to this package\" (§5.3 include filter).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Package name this override applies to (match by name; a trailing `*`\nor `**` path glob is matched against the package root).",
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "description": "Whether the package is released at all.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PreMajorCfg": {
      "description": "Pre-1.0 bump remapping (§10.2): `{ breaking = \"minor\", feat = \"patch\" }`.",
      "properties": {
        "breaking": {
          "anyOf": [
            {
              "$ref": "#/$defs/BumpLevel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bump applied to breaking commits before 1.0 (default `minor`)."
        },
        "feat": {
          "anyOf": [
            {
              "$ref": "#/$defs/BumpLevel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Bump applied to `feat` commits before 1.0 (default `patch`)."
        }
      },
      "type": "object"
    },
    "PublishCfg": {
      "description": "`[publish]` section (§13). Publishing is opt-in.",
      "properties": {
        "cargo": {
          "anyOf": [
            {
              "$ref": "#/$defs/CargoPublishCfg"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cargo publishing options."
        },
        "enabled": {
          "description": "Master switch; default `false` (safe-by-default, invariant I7).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "npm": {
          "anyOf": [
            {
              "$ref": "#/$defs/NpmPublishCfg"
            },
            {
              "type": "null"
            }
          ],
          "description": "npm publishing options."
        }
      },
      "type": "object"
    },
    "RepoCfg": {
      "description": "`[repo]` section.",
      "properties": {
        "base_branch": {
          "description": "Base branch plans are computed against. Default: the remote HEAD.",
          "type": [
            "string",
            "null"
          ]
        },
        "tag_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/TagStyle"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tag naming style: `auto`, a tag template such as `{name}-v{version}`,\nor `v{version}` (appendix A.3)."
        }
      },
      "type": "object"
    },
    "TagStyle": {
      "description": "Tag naming style (appendix A.3): the literal `auto`, or a template\ncontaining `{name}` / `{version}` placeholders such as `{name}-v{version}`\nor `v{version}`. The loader (`M1.8`) validates `auto` and the template\ngrammar.",
      "type": "string"
    },
    "VersionPolicy": {
      "description": "Workspace versioning policy (§5.4).",
      "oneOf": [
        {
          "const": "independent",
          "description": "Every package versions on its own.",
          "type": "string"
        },
        {
          "const": "fixed",
          "description": "All packages in the group share one version.",
          "type": "string"
        },
        {
          "const": "linked",
          "description": "Packages move together at the same bump level.",
          "type": "string"
        }
      ]
    },
    "VersioningCfg": {
      "description": "`[versioning]` section.",
      "properties": {
        "cascade": {
          "anyOf": [
            {
              "$ref": "#/$defs/CascadePolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cascade policy for dependents of bumped packages (§10.4)."
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "`independent` (default) | `fixed` | `linked` (§5.4)."
        },
        "pre_major": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreMajorCfg"
            },
            {
              "type": "null"
            }
          ],
          "description": "Breaking/feat mapping in `0.y.z` releases (§10.2); Cargo-compatible\ndefaults."
        }
      },
      "type": "object"
    }
  },
  "$id": "https://halyard.dev/schemas/halyard-config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Root of `halyard.toml` (§16.4). Unknown keys are reported as errors with\n`did-you-mean` suggestions by the loader (`M1.8`).",
  "properties": {
    "changelog": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChangelogCfg"
        },
        {
          "type": "null"
        }
      ],
      "description": "Changelog rendering options."
    },
    "commits": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitsCfg"
        },
        {
          "type": "null"
        }
      ],
      "description": "Commit-derived bump configuration."
    },
    "forge": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForgeCfg"
        },
        {
          "type": "null"
        }
      ],
      "description": "Forge adapter selection."
    },
    "link": {
      "description": "Explicit polyglot links (`[[link]]`, §6.5).",
      "items": {
        "$ref": "#/$defs/LinkCfg"
      },
      "type": "array"
    },
    "package": {
      "description": "Per-package overrides, matched by name or path glob (`[[package]]`).",
      "items": {
        "$ref": "#/$defs/PackageOverride"
      },
      "type": "array"
    },
    "publish": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublishCfg"
        },
        {
          "type": "null"
        }
      ],
      "description": "Publishing options (opt-in; §13)."
    },
    "repo": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepoCfg"
        },
        {
          "type": "null"
        }
      ],
      "description": "Repository-wide options: base branch, tag naming."
    },
    "versioning": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersioningCfg"
        },
        {
          "type": "null"
        }
      ],
      "description": "Versioning policy: grouping, pre-major handling, cascade."
    }
  },
  "title": "HalyardConfig",
  "type": "object"
}
